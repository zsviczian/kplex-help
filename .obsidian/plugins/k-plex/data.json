          "help-workbench": {
            "version": 1,
            "name": "Workbench questions",
            "source": "rules",
            "field": "learningMode",
            "categories": {
              "read-short": {
                "label": "Read briefly",
                "values": [
                  "read-short"
                ],
                "color": {
                  "kind": "theme",
                  "variable": "--color-blue"
                },
                "rule": "note.learningMode == \"read\" and note.sessionSize == \"short\""
              },
              "read-longer": {
                "label": "Read deeply",
                "values": [
                  "read-longer"
                ],
                "color": {
                  "kind": "theme",
                  "variable": "--color-green"
                },
                "rule": "note.learningMode == \"read\" and note.sessionSize == \"longer\""
              },
              "practice-longer": {
                "label": "Set aside practice time",
                "values": [
                  "practice-longer"
                ],
                "color": {
                  "kind": "theme",
                  "variable": "--color-orange"
                },
                "rule": "note.learningMode == \"practice\" and note.sessionSize == \"longer\""
              },
              "practice-short": {
                "label": "Try something small",
                "values": [
                  "practice-short"
                ],
                "color": {
                  "kind": "theme",
                  "variable": "--color-purple"
                },
                "rule": "note.learningMode == \"practice\" and note.sessionSize == \"short\""
              }
            },
            "order": [
